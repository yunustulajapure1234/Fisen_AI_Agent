# ========================================================
# FISEN Technologies AI Assistant - Environment Configuration
# ========================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Trust reverse proxy (Nginx, Traefik, Cloudflare, AWS ALB)
# Set to 'true' if running behind a reverse proxy so client IPs are detected correctly
TRUST_PROXY=false

# Allowed CORS Origins (comma-separated for multiple, or '*' for open access)
CORS_ORIGIN=*

# Rate Limiting: Max requests per 15 minutes per IP on /api/chat
RATE_LIMIT_MAX=60

# ========================================================
# AI & Vector Database Services
# ========================================================

# Groq API (Required for inference)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Pinecone Vector Database (Required for semantic search / RAG)
# Obtain from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=companychat-local
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=768

# Ollama Embeddings (Required for vector embedding generation)
# Defaults to local Ollama instance on port 11434
# For production docker or remote server, use e.g. http://ollama:11434 or your private endpoint
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
